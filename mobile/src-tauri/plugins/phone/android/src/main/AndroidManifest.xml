<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- since Android 11 an app must say that it looks for the phone's text-to-speech service -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application>
        <!-- hands a verse picture to the app it is shared with (PhonePlugin.shareImage) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.phone.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/phone_file_paths" />
        </provider>
    </application>
</manifest>
