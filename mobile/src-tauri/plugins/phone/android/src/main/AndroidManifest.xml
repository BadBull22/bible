<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- since Android 11 an app must say that it looks for the phone's text-to-speech service -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <!-- to hand a downloaded update of this app to Android's installer (PhonePlugin.installUpdate);
         the reader must still allow it for this app, and confirm each install -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- the daily reminder on time: exact alarms (Android 12: asked; 13 and newer: given to an
         app whose reminder is the reader's own choice), and the reader's leave to run in the
         background, which some phones (Huawei, Honor, Xiaomi) need before any alarm comes -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application>
        <!-- hands a verse picture to the app it is shared with (PhonePlugin.shareImage), and a
             downloaded update to the installer (PhonePlugin.installUpdate) -->
        <provider
            android:name="com.ghostclaw.phone.PhoneFileProvider"
            android:authorities="${applicationId}.phone.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/phone_file_paths" />
        </provider>
    </application>
</manifest>
