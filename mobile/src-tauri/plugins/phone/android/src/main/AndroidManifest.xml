<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- since Android 11 an app must say that it looks for the phone's text-to-speech service -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <!-- to hand a downloaded update of this app to Android's installer (PhonePlugin.installUpdate);
         the reader must still allow it for this app, and confirm each install -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- the daily reminder on time: exact alarms (Android 12: asked; 13 and newer: given to an
         app whose reminder is the reader's own choice), and the reader's leave to run in the
         background, which some phones (Huawei, Honor, Xiaomi) need before any alarm comes -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Listen mode: the Bible read aloud with the screen off (a foreground service of the media playback kind, with a notification and lock-screen
         controls), and the daily notifications and the verse widget that start again after the phone restarts -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <receiver android:name="com.ghostclaw.phone.NotifyReceiver" android:exported="false" />
        <receiver android:name="com.ghostclaw.phone.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- the home-screen widget with the verse for the day -->
        <receiver android:name="com.ghostclaw.phone.VerseWidget" android:exported="true" android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.ghostclaw.phone.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/verse_widget_info" />
        </receiver>
        <service android:name="com.ghostclaw.phone.ListenService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <!-- hands a verse picture to the app it is shared with (PhonePlugin.shareImage), and a
             downloaded update to the installer (PhonePlugin.installUpdate) -->
        <provider
            android:name="com.ghostclaw.phone.PhoneFileProvider"
            android:authorities="${applicationId}.phone.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/phone_file_paths" />
        </provider>
    </application>
</manifest>
